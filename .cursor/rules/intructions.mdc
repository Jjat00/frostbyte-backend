## 📊 Modelos de Datos

### App: `products`

```python
# Categoría de productos
class Category(models.Model):
    name = models.CharField(max_length=100)  # ej: "Granizados", "Frappés"
    slug = models.SlugField(unique=True)
    description = models.TextField(blank=True)
    display_order = models.PositiveIntegerField(default=0)
    is_active = models.BooleanField(default=True)

# Producto
class Product(models.Model):
    category = models.ForeignKey(Category, on_delete=models.CASCADE)
    name = models.CharField(max_length=200)  # ej: "Mango Biche"
    slug = models.SlugField(unique=True)
    description = models.TextField()
    image_url = models.URLField(blank=True)
    is_active = models.BooleanField(default=True)
    is_coming_soon = models.BooleanField(default=False)
    created_at = models.DateTimeField(auto_now_add=True)
    updated_at = models.DateTimeField(auto_now=True)

# Variantes de producto (tamaños, bases, etc.)
class ProductVariant(models.Model):
    product = models.ForeignKey(Product, on_delete=models.CASCADE, related_name='variants')
    name = models.CharField(max_length=100)  # ej: "Pequeño", "Grande", "Base Milo"
    sku = models.CharField(max_length=50, unique=True)
    is_default = models.BooleanField(default=False)
```

### App: `inventory`

```python
# Unidades de medida
class UnitOfMeasure(models.Model):
    name = models.CharField(max_length=50)  # ej: "gramos", "ml", "unidad"
    abbreviation = models.CharField(max_length=10)  # ej: "g", "ml", "u"

# Materia prima
class RawMaterial(models.Model):
    name = models.CharField(max_length=200)  # ej: "Pulpa de Mango"
    unit = models.ForeignKey(UnitOfMeasure, on_delete=models.PROTECT)
    current_stock = models.DecimalField(max_digits=10, decimal_places=2, default=0)
    minimum_stock = models.DecimalField(max_digits=10, decimal_places=2, default=0)
    cost_per_unit = models.DecimalField(max_digits=10, decimal_places=2)  # Costo por unidad
    supplier = models.CharField(max_length=200, blank=True)
    is_active = models.BooleanField(default=True)

# Receta: materia prima necesaria para cada variante de producto
class Recipe(models.Model):
    product_variant = models.ForeignKey(ProductVariant, on_delete=models.CASCADE, related_name='recipe')
    raw_material = models.ForeignKey(RawMaterial, on_delete=models.CASCADE)
    quantity = models.DecimalField(max_digits=10, decimal_places=2)  # Cantidad necesaria
```

### App: `pricing`

```python
# Precios de venta y costos
class ProductPrice(models.Model):
    product_variant = models.OneToOneField(ProductVariant, on_delete=models.CASCADE, related_name='price')
    sale_price = models.DecimalField(max_digits=10, decimal_places=2)  # Precio de venta
    # El costo real se calcula automáticamente desde la receta

    @property
    def real_cost(self):
        """Calcula el costo real basado en la receta"""
        total = Decimal('0')
        for item in self.product_variant.recipe.all():
            total += item.quantity * item.raw_material.cost_per_unit
        return total

    @property
    def profit(self):
        """Ganancia = Precio de venta - Costo real"""
        return self.sale_price - self.real_cost

    @property
    def profit_margin(self):
        """Margen de ganancia en porcentaje"""
        if self.sale_price > 0:
            return (self.profit / self.sale_price) * 100
        return Decimal('0')
```

### App: `orders`

```python
# Pedido
class Order(models.Model):
    class Status(models.TextChoices):
        PENDING = 'pending', 'Pendiente'
        PREPARING = 'preparing', 'Preparando'
        READY = 'ready', 'Listo'
        DELIVERED = 'delivered', 'Entregado'
        CANCELLED = 'cancelled', 'Cancelado'

    order_number = models.CharField(max_length=20, unique=True)
    customer_name = models.CharField(max_length=200, blank=True)
    status = models.CharField(max_length=20, choices=Status.choices, default=Status.PENDING)
    notes = models.TextField(blank=True)
    total = models.DecimalField(max_digits=10, decimal_places=2, default=0)
    created_at = models.DateTimeField(auto_now_add=True)
    updated_at = models.DateTimeField(auto_now=True)

# Items del pedido
class OrderItem(models.Model):
    order = models.ForeignKey(Order, on_delete=models.CASCADE, related_name='items')
    product_variant = models.ForeignKey(ProductVariant, on_delete=models.PROTECT)
    quantity = models.PositiveIntegerField(default=1)
    unit_price = models.DecimalField(max_digits=10, decimal_places=2)
    subtotal = models.DecimalField(max_digits=10, decimal_places=2)

    # Addons (ej: "envenenar" con shot de licor)
    addons = models.ManyToManyField(ProductVariant, related_name='order_addons', blank=True)
    addons_total = models.DecimalField(max_digits=10, decimal_places=2, default=0)
```

