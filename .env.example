# Database Configuration
DATABASE_URL=postgresql://frostbyte:frostbyte@localhost:5432/frostbyte

# Django Configuration
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True

# Frontend URL (used for OAuth redirects)
FRONTEND_URL=http://localhost:5173

# OpenAI Configuration (image generation, recommendations, transcription)
OPENAI_API_KEY=your-openai-api-key

# Google Gemini Configuration (image generation - default provider)
GEMINI_API_KEY=your-gemini-api-key

# Spotify Configuration (music requests - optional, alternative to YouTube)
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
SPOTIFY_REDIRECT_URI=http://localhost:8000/api/v1/spotify/callback/

# YouTube Data API v3 (music/video requests - default source)
# Get API key: https://console.cloud.google.com -> Enable "YouTube Data API v3" -> Credentials
YOUTUBE_API_KEY=your-youtube-api-key
# Daily quota limit (free tier = 10000 units/day; request increase in Google Cloud Console for more)
YOUTUBE_QUOTA_LIMIT=10000

# Cloudflare R2 Storage Configuration
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_URL=https://your-bucket.r2.dev

# Redis Configuration (optional in dev, required in production)
# Used for WebSocket channel layers AND cache (YouTube responses)
REDIS_URL=redis://localhost:6379
