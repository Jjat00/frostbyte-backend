# Database Configuration
DATABASE_URL=postgresql://frostbyte:frostbyte@localhost:5432/frostbyte

# Django Configuration
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True

# Frontend URL (used for OAuth redirects)
FRONTEND_URL=http://localhost:5173

# OpenAI Configuration (image generation, recommendations, transcription)
OPENAI_API_KEY=your-openai-api-key

# Google Gemini Configuration (image generation - default provider)
GEMINI_API_KEY=your-gemini-api-key

# Google Sign-In (login de clientes con Google)
# OAuth 2.0 Client ID (tipo "Web application") de Google Cloud Console.
# Debe ser el MISMO valor que VITE_GOOGLE_CLIENT_ID en el frontend.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Spotify Configuration (music requests - optional, alternative to YouTube)
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
SPOTIFY_REDIRECT_URI=http://localhost:8000/api/v1/spotify/callback/

# YouTube Data API v3 (music/video requests - default source)
# Get API key: https://console.cloud.google.com -> Enable "YouTube Data API v3" -> Credentials
YOUTUBE_API_KEY=your-youtube-api-key
# Daily quota limit (free tier = 10000 units/day; request increase in Google Cloud Console for more)
YOUTUBE_QUOTA_LIMIT=10000

# Cloudflare R2 Storage Configuration
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_URL=https://your-bucket.r2.dev

# Redis Configuration (optional in dev, required in production)
# Used for WebSocket channel layers AND cache (YouTube responses)
REDIS_URL=redis://localhost:6379

# Polla Mundialista - API-Football (api-sports.io)
# Opcional. Sin esta key la Polla funciona con el calendario sembrado;
# con ella, "python manage.py polla_sync" trae resultados/posiciones en vivo.
# Consigue una key en https://www.api-football.com/ (header x-apisports-key).
API_FOOTBALL_KEY=
API_FOOTBALL_LEAGUE_ID=1
API_FOOTBALL_SEASON=2026
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# Correo de la Polla (Resend) — recordatorios a los participantes
# Consigue la API key en https://resend.com (Settings -> API Keys) y verifica el
# dominio frostbyte.com.co (Domains -> Add) agregando los registros SPF/DKIM/DMARC
# en Cloudflare. Sin dominio verificado los correos caen en spam.
RESEND_API_KEY=
# Remitente: debe ser una dirección del dominio verificado. El nombre es libre.
POLLA_EMAIL_FROM=Frostbyte Polla <polla@frostbyte.com.co>
# Reply-To: a dónde llegan las respuestas (no requiere buzón en el dominio).
POLLA_EMAIL_REPLY_TO=frostbyte.col@gmail.com
# URL pública de la Polla (botón del correo) y base del backend (enlace de baja).
POLLA_PUBLIC_URL=https://frostbyte.com.co/polla-mundial
BACKEND_PUBLIC_URL=https://frostbyte-backend-production.up.railway.app
SITE_URL=https://frostbyte.com.co

# Agente de pedidos por WhatsApp (Kapso + LangGraph). La API key sale del panel
# de Kapso; el webhook secret se define al crear el webhook apuntando a
# {BACKEND_PUBLIC_URL}/api/v1/whatsapp/webhook/. KAPSO_PHONE_NUMBER_IDS son los
# phone_number_id de los números conectados, separados por coma.
KAPSO_API_KEY=
KAPSO_WEBHOOK_SECRET=
KAPSO_PHONE_NUMBER_IDS=
WHATSAPP_AGENT_ENABLED=True
WHATSAPP_AGENT_MODEL=gpt-4o-mini
# Datos que el agente comparte para pagos por transferencia/Nequi/Daviplata
WHATSAPP_TRANSFER_INFO=Nequi 300XXXXXXX a nombre de Frostbyte
